# ==============================================================================
# Sevenseas Broadband — Environment Configuration Template
# DO NOT COMMIT PRODUCTION SECRETS OR CREDENTIALS TO SOURCE CONTROL
# ==============================================================================

# Database Connection (PostgreSQL with SSL enabled in production)
DATABASE_URL="postgresql://sevenseas_user:SECURE_PASSWORD@postgres.internal:5432/sevenseas_db?sslmode=require"

# Cloudflare Turnstile Anti-Bot Security
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAAx_DUMMY_TURNSTILE_KEY"
TURNSTILE_SECRET_KEY="0x4AAAAAAAx_DUMMY_SECRET_KEY"

# Transactional Email Dispatch (Resend or SMTP)
RESEND_API_KEY="re_sample_api_key_here"
NOTIFICATION_EMAIL="sales@sevenseasbroadband.in"
SUPPORT_EMAIL="support@sevenseasbroadband.in"

# Application Environment
NODE_ENV="production"
PORT=3000
ALLOWED_ORIGIN="https://sevenseasbroadband.in"
